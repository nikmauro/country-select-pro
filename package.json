{
  "name": "country-select-pro",
  "version": "6.5.0",
  "description": "Lightweight, zero-dependency vanilla JS country selector: flags, phone codes, search, custom lists, ARIA, Bootstrap 5 or plain CSS.",
  "main": "dist/country-select.js",
  "module": "dist/country-select.mjs",
  "types": "dist/country-select.d.ts",
  "style": "dist/country-select.css",
  "jsdelivr": "dist/country-select.min.js",
  "unpkg": "dist/country-select.min.js",
  "exports": {
    ".": {
      "types": "./dist/country-select.d.ts",
      "import": "./dist/country-select.mjs",
      "require": "./dist/country-select.js",
      "default": "./dist/country-select.js"
    },
    "./css": "./dist/country-select.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikmauro/country-select-pro.git"
  },
  "keywords": [
    "country",
    "country-select",
    "country-picker",
    "dropdown",
    "flags",
    "phone-code",
    "select",
    "bootstrap",
    "htmx",
    "accessible",
    "vanilla-js"
  ],
  "scripts": {
    "build:data": "node scripts/build-data.js",
    "build": "gulp build",
    "check:types": "tsc -p test/tsconfig.json",
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "prepublishOnly": "npm run build",
    "version": "node scripts/version.js"
  },
  "author": "Nikolaos Mavroidis",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nikmauro/country-select-pro/issues"
  },
  "homepage": "https://github.com/nikmauro/country-select-pro",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "bootstrap": "5.3",
    "gulp": "^5.0.1",
    "gulp-cli": "^3.1.0",
    "gulp-rename": "^2.1.0",
    "gulp-terser": "^2.1.0",
    "htmx.org": "^2.0.11",
    "idiomorph": "^0.8.0",
    "libphonenumber-js": "^1.13.15",
    "typescript": "^5.9.3"
  },
  "sideEffects": true
}
